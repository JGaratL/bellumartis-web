PORT=5000
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Public URL where the frontend will receive verification/reset links
FRONTEND_URL=http://localhost:5173

# Remove unverified local accounts after this many days
UNVERIFIED_ACCOUNT_TTL_DAYS=7

# Public contact report throttling (shared MySQL storage)
CONTACT_REPORTS_PER_15_MIN=5
CONTACT_REPORT_WINDOW_MINUTES=15
CONTACT_REPORTS_PER_DAY=15
CONTACT_REPORT_MIN_INTERVAL_SECONDS=30

# SMTP configuration
# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-app-password
# MAIL_FROM="BellumArtis <tu-correo@gmail.com>"

# DeepBlueWork: endpoint de recepción y clave de tu cuenta
DEEPBLUEWORK_URL=
DEEPBLUEWORK_TOKEN=
