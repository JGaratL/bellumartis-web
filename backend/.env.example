PORT=5000
JWT_SECRET=change-me
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=bellumartis
GOOGLE_CLIENT_ID=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Public URL where the frontend will receive verification/reset links
FRONTEND_URL=http://localhost:5173
# Exact browser origins allowed to call the API (comma-separated in production)
FRONTEND_ORIGINS=http://localhost:5173
# Use "none" only when frontend and API are on different sites; this also requires HTTPS
COOKIE_SAME_SITE=lax

# Remove unverified local accounts after this many days
UNVERIFIED_ACCOUNT_TTL_DAYS=7

# Public contact report throttling (shared MySQL storage)
CONTACT_REPORTS_PER_15_MIN=5
CONTACT_REPORT_WINDOW_MINUTES=15
CONTACT_REPORTS_PER_DAY=15
CONTACT_REPORT_MIN_INTERVAL_SECONDS=30

# SMTP configuration
# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-app-password
# MAIL_FROM="BellumArtis <tu-correo@gmail.com>"

# DeepBlueWork: endpoint de recepción y clave de tu cuenta
DEEPBLUEWORK_URL=
DEEPBLUEWORK_TOKEN=
